---
import Faq from "../components/home/Faq.astro";
import Hero from "../components/home/Hero.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import Solutions from "../components/home/Solutions.astro";

import CompactFooter from "../components/layout/CompactFooter.astro";
import Header from "../components/layout/Header.astro";

import HomeSchemas from "../components/seo/HomeSchemas.astro";

import { SITE_CONFIG } from "../constants/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title={SITE_CONFIG.title}
	description={SITE_CONFIG.description}
>
	<Fragment slot="head">
		<HomeSchemas />
	</Fragment>

	<Header />

	<main>
		<Hero />
		<HowItWorks />
		<Solutions />
		<Faq />
	</main>

	<CompactFooter />
</BaseLayout>