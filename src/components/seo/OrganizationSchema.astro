---
import JsonLd from "./JsonLd.astro";

interface Props {
	id: string;
	name: string;
	url: string;
	logo?: string;
	sameAs?: string[];
}

const {
	id,
	name,
	url,
	logo,
	sameAs = [],
} = Astro.props;

const schema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"@id": id,
	name,
	url,

	...(logo
		? {
				logo: {
					"@type": "ImageObject",
					url: logo,
				},
			}
		: {}),

	...(sameAs.length > 0
		? {
				sameAs,
			}
		: {}),
};
---

<JsonLd data={schema} />