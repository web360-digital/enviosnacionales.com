---
import { EXTERNAL_LINKS } from "../../constants/external-links";
import { HEADER_NAVIGATION } from "../../constants/navigation";
import { SITE_CONFIG } from "../../constants/site";

import "../../styles/components/compact-footer.css";

const currentYear = new Date().getFullYear();
---

<footer class="compact-footer">
	<div class="compact-footer__container container">
		<div class="compact-footer__main">
			<a
				class="compact-footer__brand"
				href={SITE_CONFIG.homeUrl}
				aria-label={`${SITE_CONFIG.name}, volver al inicio`}
			>
				<span
					class="compact-footer__brand-icon"
					aria-hidden="true"
				>
					<svg
						viewBox="0 0 24 24"
						width="23"
						height="23"
						fill="none"
					>
						<path
							d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5v-9Z"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linejoin="round"
						/>

						<path
							d="m3.5 7.7 8.5 4.2 8.5-4.2M12 12v8.5"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linejoin="round"
						/>
					</svg>
				</span>

				<span class="compact-footer__brand-copy">
					<strong class="compact-footer__brand-name">
						{SITE_CONFIG.name}
					</strong>

					<span class="compact-footer__brand-description">
						Envíos dentro de México
					</span>
				</span>
			</a>

			<nav
				class="compact-footer__navigation"
				aria-label="Navegación del pie de página"
			>
				<ul>
					{
						HEADER_NAVIGATION.map((item) => (
							<li>
								<a href={item.href}>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<a
				class="compact-footer__cta"
				href={EXTERNAL_LINKS.finalQuote}
				aria-label="Cotizar un envío nacional"
			>
				Cotizar envío

				<svg
					viewBox="0 0 20 20"
					width="17"
					height="17"
					fill="none"
					aria-hidden="true"
				>
					<path
						d="M4 10h12M11 5l5 5-5 5"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			</a>
		</div>

		<div class="compact-footer__bottom">
			<p class="compact-footer__copyright">
				© {currentYear} {SITE_CONFIG.name}. Todos los derechos reservados.
			</p>

			<p class="compact-footer__description">
				Cotiza, genera guías y administra tus envíos nacionales.
			</p>

			<a
				class="compact-footer__platform-link"
				href={EXTERNAL_LINKS.finalQuote}
			>
				Continuar en DrEnvío

				<svg
					viewBox="0 0 20 20"
					width="15"
					height="15"
					fill="none"
					aria-hidden="true"
				>
					<path
						d="M4 10h12M11 5l5 5-5 5"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			</a>
		</div>
	</div>
</footer>