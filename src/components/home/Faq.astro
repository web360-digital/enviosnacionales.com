---
import { EXTERNAL_LINKS } from "../../constants/external-links";
import { FAQ_CONTENT } from "../../constants/home";

import "../../styles/components/faq.css";

const FAQ_LINKS = {
	quote: EXTERNAL_LINKS.faqQuote,
	nationalShipping: EXTERNAL_LINKS.faqNationalShipping,
	tracking: EXTERNAL_LINKS.faqTracking,
	platform: EXTERNAL_LINKS.faqPlatform,
	integrations: EXTERNAL_LINKS.faqIntegrations,
} as const;

---

<section
	id="preguntas-frecuentes"
	class="faq"
	aria-labelledby="faq-title"
>
	<div class="faq__container container">
		<header class="faq__intro">
			<p class="faq__eyebrow">
				<span aria-hidden="true"></span>

				{FAQ_CONTENT.eyebrow}
			</p>

			<h2
				id="faq-title"
				class="faq__title"
			>
				{FAQ_CONTENT.title}
			</h2>

			<p class="faq__description">
				{FAQ_CONTENT.description}
			</p>

			<a
				class="faq__main-link"
				href={EXTERNAL_LINKS.faqQuote}
			>
				Cotizar un envío

				<svg
					viewBox="0 0 20 20"
					width="17"
					height="17"
					fill="none"
					aria-hidden="true"
				>
					<path
						d="M4 10h12M11 5l5 5-5 5"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			</a>
		</header>

		<div class="faq__list">
			{
				FAQ_CONTENT.items.map((item, index) => (
					<details
						id={item.id}
						class="faq-item"
						data-faq-item
					>
						<summary class="faq-item__question">
							<span class="faq-item__number">
								{String(index + 1).padStart(2, "0")}
							</span>

							<span class="faq-item__question-text">
								{item.question}
							</span>

							<span
								class="faq-item__toggle"
								aria-hidden="true"
							>
								<svg
									viewBox="0 0 20 20"
									width="18"
									height="18"
									fill="none"
								>
									<path
										d="M4 10h12M10 4v12"
										stroke="currentColor"
										stroke-width="1.7"
										stroke-linecap="round"
									/>
								</svg>
							</span>
						</summary>

						<div class="faq-item__answer">
							<p>{item.answer}</p>

							<div class="faq-item__links">
								<a href={FAQ_LINKS[item.link]}>
									{item.linkLabel}

									<svg
										viewBox="0 0 20 20"
										width="16"
										height="16"
										fill="none"
										aria-hidden="true"
									>
										<path
											d="M4 10h12M11 5l5 5-5 5"
											stroke="currentColor"
											stroke-width="1.8"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</a>

								{
									"secondaryLink" in item &&
									item.secondaryLink &&
									"secondaryLinkLabel" in item && (
										<a
											class="faq-item__secondary-link"
											href={FAQ_LINKS[item.secondaryLink]}
										>
											{item.secondaryLinkLabel}
										</a>
									)
								}
							</div>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>


<script>
	const faqItems =
		document.querySelectorAll<HTMLDetailsElement>(
			"[data-faq-item]",
		);

	faqItems.forEach((item) => {
		item.addEventListener("toggle", () => {
			if (!item.open) {
				return;
			}

			faqItems.forEach((otherItem) => {
				if (otherItem !== item) {
					otherItem.open = false;
				}
			});
		});
	});
</script>